{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "OSDM capture",
  "version": "0.1.1",
  "description": "Send explicitly selected links and eligible downloads to your local OSDM application.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["nativeMessaging", "contextMenus", "downloads", "storage", "activeTab", "scripting", "notifications"],
  "optional_permissions": ["cookies", "webRequest"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "options.html", "default_title": "OSDM capture", "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png" } }
}
